# Pick ONE provider. Gemini is used automatically if GEMINI_API_KEY is set.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash

# Or OpenAI (needs API credits):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Force a provider if both keys are set (gemini or openai):
# LLM_PROVIDER=gemini
